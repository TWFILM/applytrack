# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string.
# Local: matches docker-compose.yml (host port 5433).
# Production: Neon connection string (use the pooled URL, with ?sslmode=require).
DATABASE_URL=postgres://applytrack:applytrack@localhost:5433/applytrack

# Better Auth. Generate a secret (32+ chars) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public URL of the app (Vercel: https://<your-app>.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — leave both empty to hide the Google button). See docs/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
